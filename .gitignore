# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — local overrides with real secrets, never commit
.env
.env.local
.env.*.local
# .env.example is intentionally NOT ignored — it's the public template

# Kiro MCP config — contains API tokens, never commit
.kiro/settings/mcp.json

# vercel
.vercel

# Cloudflare / OpenNext build artifacts — generated at build time, never commit
.open-next/
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# open-next build artifacts
.open-next/

# wrangler state and build
.wrangler/

# Android / Trusted Web Activity build artifacts
.gradle/
/android-app/.gradle/
/android-app/build/
/.idea/
/android-app/.idea/
/android-app/local.properties
local.properties
android.keystore
*.keystore
*.jks
*.apk
*.aab
*.idsig

# local helper files
commits.txt
