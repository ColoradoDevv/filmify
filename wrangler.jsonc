{
  "name": "filmify",

  // ── Runtime ────────────────────────────────────────────────────────────────
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // ── Entry point ────────────────────────────────────────────────────────────
  "main": "./custom-worker.ts",

  // ── Static assets ──────────────────────────────────────────────────────────
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // ── Cache ISR — Cloudflare KV ─────────────────────────────────────────────
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "f38aea99d1704c48ad9d2887e162c81e",
      "preview_id": "d6a420d03cbc4e8fa8baf1442b282667"
    }
  ],

  // ── Cron triggers ─────────────────────────────────────────────────────────
  "triggers": {
    "crons": ["0 0 * * *", "0 6 * * *", "0 9 * * *"]
  },

  // ── Observability ─────────────────────────────────────────────────────────
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  // ═══════════════════════════════════════════════════════════════════════════
  // VARIABLES DE ENTORNO (públicas — se pueden leer en el worker)
  // Los SECRETOS (API keys, service roles, etc.) NO van aquí.
  // Subirlos vía: wrangler secret put <NOMBRE>  o  Dashboard → Variables & Secrets
  // ═══════════════════════════════════════════════════════════════════════════
  "vars": {
    // ── TMDB (pública, usada por el frontend para imágenes/listados) ────────
    "NEXT_PUBLIC_TMDB_API_KEY": "d787e52267da1e31f280c916fed352ca",

    // ── Supabase (públicas) ─────────────────────────────────────────────────
    "NEXT_PUBLIC_SUPABASE_URL": "https://cyiifumieluunoujaxbs.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_LjrrpSjvSiAICTuCO5kpmQ_CDGHQyU0",

    // ── Vimeus (solo la view key es pública) ────────────────────────────────
    "NEXT_PUBLIC_VIMEUS_VIEW_KEY": "MdNWs7_Dy4aRxsH1mTIvB-7U-cBzD2_OG6AU_SZCvEw",

    // ── hCaptcha (pública) ──────────────────────────────────────────────────
    "NEXT_PUBLIC_HCAPTCHA_SITE_KEY": "f308c03a-ec9e-4dfc-8a18-5c20ed52775e",

    // ── Donaciones (pública) ────────────────────────────────────────────────
    "NEXT_PUBLIC_DONATE_URL": "https://filmify.me/donar",

    // ── Analytics & Ads (públicas, opcionales) ──────────────────────────────
    "NEXT_PUBLIC_GA_ID": "",
    "NEXT_PUBLIC_ADSENSE_CLIENT_ID": "",

    // ── Base URL pública de la app ──────────────────────────────────────────
    "NEXT_PUBLIC_APP_URL": "https://filmify.me"
  },

  // ═══════════════════════════════════════════════════════════════════════════
  // PREVIEW ENVIRONMENT
  // ═══════════════════════════════════════════════════════════════════════════
  "env": {
    "preview": {
      "name": "filmify-preview",
      "kv_namespaces": [
        {
          "binding": "NEXT_INC_CACHE_KV",
          "id": "d6a420d03cbc4e8fa8baf1442b282667",
          "preview_id": "d6a420d03cbc4e8fa8baf1442b282667"
        }
      ],
      "triggers": {
        "crons": ["0 0 * * *", "0 6 * * *", "0 9 * * *"]
      },
      "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true,
          "invocation_logs": true
        },
        "traces": {
          "enabled": false,
          "persist": true,
          "head_sampling_rate": 1
        }
      },

      // ── Variables de preview (mismas claves, valores de staging/dev) ──────
      "vars": {
        "NEXT_PUBLIC_TMDB_API_KEY": "d787e52267da1e31f280c916fed352ca",
        "NEXT_PUBLIC_SUPABASE_URL": "https://cyiifumieluunoujaxbs.supabase.co",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_LjrrpSjvSiAICTuCO5kpmQ_CDGHQyU0",
        "NEXT_PUBLIC_VIMEUS_VIEW_KEY": "MdNWs7_Dy4aRxsH1mTIvB-7U-cBzD2_OG6AU_SZCvEw",
        "NEXT_PUBLIC_HCAPTCHA_SITE_KEY": "f308c03a-ec9e-4dfc-8a18-5c20ed52775e",
        "NEXT_PUBLIC_DONATE_URL": "https://filmify.jmcolorado1027.workers.dev/donar",
        "NEXT_PUBLIC_GA_ID": "",
        "NEXT_PUBLIC_ADSENSE_CLIENT_ID": "",
        "NEXT_PUBLIC_APP_URL": "https://filmify.jmcolorado1027.workers.dev/"
      }
    }
  }
}