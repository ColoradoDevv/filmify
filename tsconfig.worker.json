{
  // tsconfig específico para custom-worker.ts.
  // NO usar para el proyecto Next.js: los tipos de Workers (ScheduledEvent,
  // ExecutionContext, etc.) colisionan con los tipos de DOM/browser.
  // Este archivo solo lo usa el check manual `tsc -p tsconfig.worker.json`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    // Excluir lib dom para evitar conflictos con los tipos de Workers
    "lib": ["esnext"]
  },
  "include": [
    "custom-worker.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
